---
layout: 'layouts/base.njk'
---

{# NOTE (SAVIZ):
  The layout automatically handles everything an index page currently needs, so
  there is no reason for it to contain {{ content | safe }}. This may change in
  the future.
#}
<section class='container-fluid mt-5'>
  <div class='container'>
    <div class='row justify-content-center align-items-center'>
      <div class='col-lg-8 text-center'>
        <h1 class='mt-3'>{{ title }}</h1>
        <p class='lead mt-3 text-mute'>{{ description }}</p>
        <a class='btn btn-lg btn-secondary my-5 rounded-pill' href='{{ returnLinkUrl }}'>{{ returnLinkString }}</a>
      </div>
    </div>

    <!-- Collection ----------------------------------------------------------->
    {%- set items = collections[targetTag] -%}
    <div class='row g-5 justify-content-center align-items-stretch'>
      {%- if items and items.length -%}
        {%- for item in items | sortByOrder -%}
          <div class='col-12 col-md-6 col-lg-4'>
            <div class='card h-100'>
              <div class='card-header'>
                <time datetime='{{ item.date }}'>
                  {{ item.date | utcDateTime }}
                </time>
              </div>
              <div class='card-body d-flex flex-column'>
                <h5 class='card-title'>{{ item.data.title }}</h5>
                {%- if item.data.description -%}
                  <p class='card-text'>
                    {{ item.data.description }}
                  </p>
                {%- endif -%}
                <a
                  class='btn btn-primary rounded-pill mt-auto align-self-start'
                  href='{{ item.url }}'
                >
                  Read Article
                </a>
              </div>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class='col-12'>
          <h2 class='text-center'>Nothing yet ¯\_(ツ)_/¯</h2>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
