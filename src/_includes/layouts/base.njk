<!DOCTYPE html>
<html lang='en' data-bs-theme='auto'>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <meta name='description' content='{{ metadata.websiteDescription }}' />
    <meta name='author' content='{{ metadata.authorName }}' />
    <title>{{ title }} | {{ metadata.websiteName }}</title>
    <link rel='preconnect' href='//privacy-proxy.usercentrics.eu' />
    <link
      rel='preload'
      href='//privacy-proxy.usercentrics.eu/latest/uc-block.bundle.js'
      as='script'
    />
    <script
      type='application/javascript'
      src='https://privacy-proxy.usercentrics.eu/latest/uc-block.bundle.js'
    ></script>
    <script
      id='usercentrics-cmp'
      src='https://app.usercentrics.eu/browser-ui/latest/loader.js'
      data-settings-id='raRSyWzQdnAZc1'
      async
    ></script>
    <script>
      uc.setCustomTranslations(
        'https://termageddon.ams3.cdn.digitaloceanspaces.com/translations/',
      );
    </script>
    <link
      rel='icon'
      type='image/png'
      href='/favicon-96x96.png?v=20260909'
      sizes='96x96'
    />
    <link rel='icon' type='image/svg+xml' href='/favicon.svg?v=20260909' />
    <link rel='shortcut icon' href='/favicon.ico?v=20260909' />
    <link
      rel='apple-touch-icon'
      sizes='180x180'
      href='/apple-touch-icon.png?v=20260909'
    />
    <meta name='apple-mobile-web-app-title' content='UsurperCS' />
    <link rel='manifest' href='/site.webmanifest?v=20260909' />
    <link
      rel='stylesheet'
      href='/assets/vendor/bootstrap/css/bootstrap.min.css'
    />
    <link
      rel='stylesheet'
      href='/assets/vendor/bootstrap-icons/bootstrap-icons.min.css'
    />
    <link rel='stylesheet' href='/css/style.css' />
    {%- if stylePaths -%}
      {%- for stylePath in stylePaths -%}
        <link rel='stylesheet' href='{{ stylePath }}' />
      {%- endfor -%}
    {%- endif -%}
  </head>
  <body>
    <div class='body-wrapper'>
      {%- include 'partials/_header.njk' -%}
      <main>{{- content | safe -}}</main>
      {%- include 'partials/_footer.njk' -%}
    </div>
    <script src='/assets/vendor/bootstrap/js/bootstrap.bundle.min.js'></script>
    <script type='module' src='/js/color_modes.js'></script>
    <script type='module' src='/js/copyright.js'></script>
    {%- if scriptPaths -%}
      {%- for scriptPath in scriptPaths -%}
        <script type='module' src='{{ scriptPath }}'></script>
      {%- endfor -%}
    {%- endif -%}
  </body>
</html>
