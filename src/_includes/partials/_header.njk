{% from "macros/navigation_link.njk" import generateNavigationLink %}

{# NOTE (SAVIZ):
  Please note that I am enforcing the dark variation for the header, knowing it looks acceptable on both the light and dark variations of the website.
#}
<header
  class='container-fluid sticky-top bg-secondary-subtle'
  data-bs-theme='dark'
>
  <nav class='navbar navbar-expand-lg'>
    <div class='container'>
      <a class='navbar-brand' href='/'>
        <img
          class='align-text-top d-inline-block'
          src='/assets/site/graphics/usurpercs_logo.svg'
          alt='Logo'
          width='30'
          height='24'
        />
        UsurperCS
      </a>
      <button
        class='navbar-toggler'
        type='button'
        data-bs-toggle='collapse'
        data-bs-target='#navbarScroll'
        aria-controls='navbarScroll'
        aria-expanded='false'
        aria-label='Toggle navigation'
      >
        <span class='navbar-toggler-icon'></span>
      </button>
      <div id='navbarScroll' class='collapse navbar-collapse'>
        <ul class='navbar-nav navbar-nav-scroll my-2 my-lg-0 ms-auto'>
          {%- for navigationObject in navigation -%}
            <li class='nav-item'>
              {{ generateNavigationLink(navigationObject, page.url, "nav-link") }}
            </li>
          {%- endfor -%}
          {# NOTE (SAVIZ):
            I have done my very best to ensure that the theme selection UI looks good.
            However, due to personal skill limitations and even issues with Bootstrap itself, I am unable to make it perfect at the moment.
            I plan on improving this in the future.
          #}
          <li class='dropdown nav-item ms-0 ms-lg-5'>
            <button
              id='bd-theme'
              class='btn btn-primary dropdown-toggle rounded-pill'
              type='button'
              data-bs-toggle='dropdown'
              aria-expanded='false'
              data-bs-display='static'
              style='--bs-btn-padding-y: 0.4rem; --bs-btn-padding-x: 2rem;'
            >
              <span id='bd-theme-text'>AUTO</span>
            </button>
            <ul
              class='dropdown-menu dropdown-menu-dark p-1 rounded-4'
              aria-labelledby='bd-theme'
            >
              <li>
                <button
                  class='dropdown-item text-center rounded-pill'
                  type='button'
                  data-bs-theme-value='light'
                >
                  Light
                </button>
              </li>
              <li>
                <button
                  class='dropdown-item my-1 text-center rounded-pill'
                  type='button'
                  data-bs-theme-value='dark'
                >
                  Dark
                </button>
              </li>
              <li>
                <button
                  class='dropdown-item text-center rounded-pill'
                  type='button'
                  data-bs-theme-value='auto'
                >
                  Auto
                </button>
              </li>
            </ul>
          </li>
        </ul>
      </div>
    </div>
  </nav>
</header>
