{%- macro generateLink(class="", href="#", target="", rel="", title="") -%}
<a{% if class %} class="{{ class }}"{% endif %} href="{{ href }}"{% if target %} target="{{ target }}"{% endif %}{% if rel %} rel="{{ rel }}"{% endif %}>{{ title }}</a>
{%- endmacro -%}
