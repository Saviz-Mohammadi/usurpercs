  I am not using Prettier formatting for this file, as the output is genuinely poor.
#}

{# prettier-ignore #}
{%- macro generateLink(
  id='',
  class='',
  href='',
  target='',
  rel='',
  title='',
  text='',
  currentUrl=''
) -%}
  {%- set isActive = currentUrl and href and currentUrl === href -%}
  {%- set classes = (class + (' active' if isActive else '')) | trim -%}

  <a
    {%- if id %} id="{{ id }}"{% endif %}
    {%- if classes %} class="{{ classes }}"{% endif %}
    {%- if href %} href="{{ href }}"{% endif %}
    {%- if target %} target="{{ target }}"{% endif %}
    {%- if rel %} rel="{{ rel }}"{% endif %}
    {%- if title %} title="{{ title }}"{% endif %}
    {%- if isActive %} aria-current="page"{% endif -%}
  >
    {{- text -}}
  </a>
{%- endmacro -%}
